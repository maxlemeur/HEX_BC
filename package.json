{
  "name": "projet_bc",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "npm run validate-openapi && next build && npm run check:performance",
    "start": "next start",
    "e2e": "node ./e2e/run-ps1.mjs e2e/smoke.ps1",
    "e2e:auth": "node ./e2e/run-ps1.mjs e2e/auth.ps1",
    "e2e:hex": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite quick",
    "e2e:hex:all": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite all",
    "e2e:hex:editor": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite editor",
    "e2e:hex:lifecycle": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite lifecycle",
    "e2e:hex:output": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite output",
    "e2e:hex:settings": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite settings",
    "e2e:hex:security": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite security",
    "e2e:hex:assemblies": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite assemblies",
    "e2e:hex:dpgf": "node ./e2e/run-ps1.mjs e2e/hex/run-all.ps1 -Suite dpgf",
    "e2e:run": "node ./e2e/run-ps1.mjs",
    "e2e:pw": "playwright test --project=chromium",
    "e2e:pw:critical": "playwright test e2e/estimates --project=chromium-critical",
    "e2e:validate-env": "node --import tsx scripts/validate-e2e-environment.ts",
    "e2e:pw:ux": "playwright test e2e/estimates/dashboard-ux.spec.ts --project=chromium",
    "e2e:pw:takeoff-matrix": "playwright test e2e/estimates/takeoff-epics-matrix.spec.ts --project=chromium",
    "e2e:pw:headed": "playwright test e2e/estimates --project=chromium --headed",
    "e2e:pw:report": "playwright show-report playwright-report",
    "e2e:rls": "vitest run --project=node src/lib/estimates/rls.e2e.test.ts",
    "supabase:validate": "node --import tsx scripts/validate-supabase-migrations.ts",
    "supabase:manifest:add": "node --import tsx scripts/add-supabase-migrations-to-manifest.ts",
    "supabase:migrations:git-guard": "node --import tsx scripts/guard-supabase-migrations.ts",
    "supabase:migrations:restamp": "node --import tsx scripts/restamp-unpushed-migrations.ts",
    "supabase:verify-local": "node --import tsx scripts/verify-local-supabase-migrations.ts",
    "db:ci:local": "node --import tsx scripts/run-local-supabase-ci.ts",
    "audit:dependencies": "node --import tsx scripts/check-dependency-audit.ts",
    "audit:signatures": "npm audit signatures",
    "check:architecture": "node --import tsx scripts/check-architecture-budgets.ts",
    "check:performance": "node --import tsx scripts/check-performance-budgets.ts",
    "benchmark:takeoff:provider": "node --env-file-if-exists=.env.local --import tsx scripts/run-takeoff-provider-benchmark.ts",
    "lint": "eslint . --max-warnings=0",
    "generate-openapi": "node --import tsx scripts/validate-openapi.ts --write",
    "validate-openapi": "node scripts/validate-openapi-runner.mjs",
    "prices:sofinther": "node --import tsx scripts/sofinther-prices.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci:node": "vitest run --project=node",
    "test:ci:jsdom": "vitest run --project=jsdom",
    "test:coverage": "vitest run --coverage",
    "test:critical-coverage": "vitest run --config vitest.critical.config.ts --coverage",
    "test:jsdom": "vitest run --project=jsdom",
    "test:node": "vitest run --project=node",
    "verify:production": "node --import tsx scripts/verify-production-build.ts",
    "check:quality": "npm run audit:dependencies && npm run audit:signatures && npm run check:architecture && npm run validate-openapi && npm run typecheck && npm run lint && npm run test:ci:node && npm run test:ci:jsdom && npm run test:critical-coverage",
    "check:release": "npm run check:quality && npm run verify:production"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.8",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-virtual": "^3.13.18",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "postal-mime": "^3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.9.3",
    "swagger-ui-dist": "^5.31.2",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
