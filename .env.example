# Runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_ESTIMATE_PORTAL_BASE_URL=
CRON_SECRET=
# Optional. Default 100 when unset.
ESTIMATE_BATCH_MAX_OPERATIONS=
# Optional. Set 1/true to expose /api/docs in production. Preview and non-production stay enabled.
ENABLE_OPENAPI_DOCS=

# Google Drive (optional, off unless every value is set and the service role is configured).
# OAuth web client: register <origin>/api/google-drive/oauth/callback as an authorized redirect URI.
MERGEONE_GOOGLE_DRIVE_ENABLED=
MERGEONE_GOOGLE_DRIVE_CLIENT_ID=
MERGEONE_GOOGLE_DRIVE_CLIENT_SECRET=
# Encrypts the stored refresh tokens: 32 random bytes in base64 (openssl rand -base64 32). Rotating it asks members to add their accounts again.
MERGEONE_GOOGLE_DRIVE_TOKEN_KEY=
# Optional writing on user-selected files (Google Picker API, restricted browser key).
MERGEONE_GOOGLE_PICKER_API_KEY=
MERGEONE_GOOGLE_CLOUD_PROJECT_NUMBER=

# Observability (optional). Reporter is a no-op when all DSNs are empty.
ERROR_REPORTING_DSN=
SENTRY_DSN=
NEXT_PUBLIC_ERROR_REPORTING_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# CI
# NODE_ENV, VERCEL_ENV, CI, and NEXT_RUNTIME are provided by the platform. Do not commit values.
# Optional same-origin or HTTPS endpoint receiving anonymized dashboard Web Vitals.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
# Fraction of page views reported when an endpoint is configured (0 to 1).
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
# Set by Vercel. Optional locally; used to display a short dashboard commit SHA.
VERCEL_GIT_COMMIT_SHA=

# E2E
# Hostname of the allowlisted critical Playwright Supabase origin.
E2E_ALLOWED_SUPABASE_HOST=
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=

# Takeoff
GEMINI_API_KEY=
# Optional Decisions API. Explicit server-only opt-in; separate API billing.
# ChatGPT plan/OAuth credentials and OPENAI_API_KEY are never reused here.
# 1 enables suggestions in intake, pre-measure preparation and cockpit.
MERGEONE_OPENAI_DECISIONS=
OPENAI_DECISIONS_API_KEY=
TAKEOFF_WORKER_SECRET=
# Used by the Edge Function relay, not read from src/.
TAKEOFF_WORKER_URL=
# Optional local/E2E escape hatches when the tenant feature flag is unset.
TAKEOFF_MODULE_FORCE_ENABLED=
TAKEOFF_MODULE_ENABLED_BY_DEFAULT=
TAKEOFF_AI_ESCALATION_ENABLED=
TAKEOFF_AI_ESCALATION_MIN_CONFIDENCE=
TAKEOFF_AI_ESCALATION_MAX_COST_CENTS=
TAKEOFF_GEMINI_BATCH_MODE=
# Optional Gemini request timeout in ms, capped at 180000. Default 60000.
TAKEOFF_GEMINI_TIMEOUT_MS=
# Optional Level C budget fallbacks when tenant flags are unset.
TAKEOFF_LEVEL_C_TIMEOUT_MS=
TAKEOFF_LEVEL_C_MAX_TOTAL_TOKENS=
TAKEOFF_LEVEL_C_MAX_COST_CENTS=

# Editor
# Virtualization: enabled=1/true, mode=on|off|auto, defaults threshold=50, row=56, overscan=8.
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_ENABLED=
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_MODE=
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_AUTO_THRESHOLD=
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_ROW_ESTIMATE=
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_OVERSCAN=
NEXT_PUBLIC_ESTIMATE_EDITOR_VIRTUALIZATION_CONTAINER_HEIGHT=
# Outlier detection: method=iqr|zscore. Defaults iqr, 1.5 IQR factor, z=3, group by category.
NEXT_PUBLIC_ESTIMATE_OUTLIER_METHOD=
NEXT_PUBLIC_ESTIMATE_OUTLIER_THRESHOLD=
NEXT_PUBLIC_ESTIMATE_OUTLIER_IQR_FACTOR=
NEXT_PUBLIC_ESTIMATE_OUTLIER_ZSCORE_THRESHOLD=
NEXT_PUBLIC_ESTIMATE_OUTLIER_GROUP_BY_CATEGORY=
