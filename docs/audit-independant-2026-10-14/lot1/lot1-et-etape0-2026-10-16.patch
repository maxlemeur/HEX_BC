+--   ...0005 compte d'une autre entreprise (cible d'une réaffectation)
+--   ...0004 nouvelle inscription, créée en fin de test
+insert into auth.users (
+  instance_id,
+  id,
+  aud,
+  role,
+  email,
+  encrypted_password,
+  email_confirmed_at,
+  raw_app_meta_data,
+  raw_user_meta_data,
+  created_at,
+  updated_at,
+  confirmation_token,
+  email_change,
+  email_change_token_new,
+  recovery_token
+)
+select
+  '00000000-0000-0000-0000-000000000000',
+  account.id,
+  'authenticated',
+  'authenticated',
+  account.email,
+  crypt('test-password', gen_salt('bf')),
+  now(),
+  '{"provider":"email","providers":["email"]}'::jsonb,
+  jsonb_build_object('full_name', account.full_name),
+  now(),
+  now(),
+  '',
+  '',
+  '',
+  ''
+from (
+  values
+    ('b5090000-0000-4000-8000-000000000001'::uuid, 'admin-b@membership-boundaries.test', 'Administratrice B'),
+    ('b5090000-0000-4000-8000-000000000002'::uuid, 'membre-b@membership-boundaries.test', 'Membre B'),
+    ('b5090000-0000-4000-8000-000000000003'::uuid, 'autre-1@membership-boundaries.test', 'Compte tiers 1'),
+    ('b5090000-0000-4000-8000-000000000005'::uuid, 'autre-2@membership-boundaries.test', 'Compte tiers 2')
+) as account(id, email, full_name);
+
+insert into public.tenants (id, name, slug, created_by)
+values
+  ('b5090000-0000-4000-8000-0000000000b1', 'Entreprise B', 'membership-boundaries-b', 'b5090000-0000-4000-8000-000000000001'),
+  ('b5090000-0000-4000-8000-0000000000c1', 'Entreprise C', 'membership-boundaries-c', 'b5090000-0000-4000-8000-000000000001'),
+  ('b5090000-0000-4000-8000-0000000000d1', 'Entreprise D', 'membership-boundaries-d', 'b5090000-0000-4000-8000-000000000003'),
