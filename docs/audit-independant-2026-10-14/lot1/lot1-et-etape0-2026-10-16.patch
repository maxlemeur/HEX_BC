@@ -0,0 +1,40 @@
+-- Ferme le rattachement forcé d'adhésion (audit indépendant 2026-10-14, S-09).
+--
+-- authenticated disposait de INSERT et UPDATE sur toute la table
+-- public.tenant_memberships, et les politiques d'écriture ne contrôlaient que
+-- le rôle admin sur tenant_id. Tout administrateur, donc tout compte
+-- auto-inscrit, pouvait par PostgREST direct rattacher à son entreprise le
+-- compte d'une autre entreprise dont il connaissait l'identifiant, ou réécrire
+-- user_id ou tenant_id d'une adhésion existante, puis lire le profil de la
+-- personne via can_view_profile.
+--
+-- Désormais, pour authenticated :
+-- * une insertion ne peut viser que soi-même, et seulement pour l'amorçage
+--   d'une entreprise créée par l'appelant et encore sans membre
+--   (can_bootstrap_tenant_membership). Les autres adhésions sont créées par
+--   handle_new_user (SECURITY DEFINER) ou par le service-role, en attendant un
+--   parcours d'invitation avec acceptation explicite par la personne invitée ;
+-- * seule la colonne role reste modifiable, sous la politique existante
+--   (administrateur de l'entreprise de l'adhésion). user_id et tenant_id sont
+--   figés ; is_default ne change que par set_active_tenant_membership_default
+--   (SECURITY DEFINER), qui ne touche que les adhésions de l'appelant.
+-- Lecture et suppression sont inchangées. Le service-role et les fonctions
+-- SECURITY DEFINER ne sont pas concernés.
+begin;
+
+revoke update on table public.tenant_memberships from authenticated;
+grant update (role) on table public.tenant_memberships to authenticated;
+
+drop policy if exists "Tenant admins can insert memberships"
+  on public.tenant_memberships;
+
+create policy "Users can bootstrap their own tenant membership"
+  on public.tenant_memberships
+  for insert
+  to authenticated
+  with check (
+    user_id = (select auth.uid())
+    and (select public.can_bootstrap_tenant_membership(tenant_id, user_id, role))
+  );
+
+commit;
