+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const { connection } = vi.hoisted(() => ({
+  connection: vi.fn(async () => undefined),
+}));
+
+vi.mock("next/server", () => ({ connection }));
+
+import { isSelfSignupEnabled, resolveSelfSignupEnabled } from "@/lib/auth/self-signup";
+
+describe("resolveSelfSignupEnabled", () => {
+  it.each([
+    { label: "absente", value: undefined, expected: true },
+    { label: "vide", value: "", expected: true },
+    { label: "\"true\"", value: "true", expected: true },
+    { label: "\"0\"", value: "0", expected: true },
+    { label: "\"false\"", value: "false", expected: false },
+    { label: "\" FALSE \"", value: " FALSE ", expected: false },
+  ])("valeur $label : inscription ouverte = $expected", ({ value, expected }) => {
+    expect(resolveSelfSignupEnabled(value)).toBe(expected);
+  });
+});
+
+describe("isSelfSignupEnabled", () => {
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    connection.mockClear();
+  });
+
+  it("relit SELF_SIGNUP_ENABLED à chaque requête au lieu de la figer au build", async () => {
+    vi.stubEnv("SELF_SIGNUP_ENABLED", "false");
+    await expect(isSelfSignupEnabled()).resolves.toBe(false);
+
+    vi.stubEnv("SELF_SIGNUP_ENABLED", "true");
+    await expect(isSelfSignupEnabled()).resolves.toBe(true);
+
+    expect(connection).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/src/lib/auth/self-signup.ts b/src/lib/auth/self-signup.ts
new file mode 100644
index 00000000..931682ab
--- /dev/null
+++ b/src/lib/auth/self-signup.ts
@@ -0,0 +1,22 @@
+import "server-only";
+
+import { connection } from "next/server";
+
+/**
+ * Interrupteur d'inscription libre `SELF_SIGNUP_ENABLED`, lu uniquement côté serveur.
+ *
+ * Ouvert par défaut : seule la valeur exacte "false" (casse et espaces ignorés) le ferme.
+ * Toute autre valeur, y compris l'absence de variable, "0" ou une chaîne vide, le laisse ouvert.
+ */
+export function resolveSelfSignupEnabled(value: string | undefined): boolean {
+  return value?.trim().toLowerCase() !== "false";
+}
+
+/**
+ * Lit l'interrupteur au moment de la requête : `connection()` exclut la page du
+ * prérendu, si bien que la valeur n'est jamais figée dans le HTML produit au build.
+ */
+export async function isSelfSignupEnabled(): Promise<boolean> {
+  await connection();
+  return resolveSelfSignupEnabled(process.env.SELF_SIGNUP_ENABLED);
+}
