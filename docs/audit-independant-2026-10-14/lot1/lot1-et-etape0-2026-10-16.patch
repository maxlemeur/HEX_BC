@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  listUnapprovedApprovalRequirements,
+  resolveForceSendReason,
+} from "./force-send-policy";
+
+// Seule barrière entre un forçage administrateur et une approbation exigée :
+// la transition SQL ne connaît pas les approbations. Un détail de règle
+// illisible ne doit jamais ouvrir le forçage.
+describe("force send policy", () => {
+  it("refuses forcing when a rule violation carries no readable details", () => {
+    expect(listUnapprovedApprovalRequirements([{ key: "rule_violation" }])).toHaveLength(1);
+    expect(
+      listUnapprovedApprovalRequirements([
+        { key: "rule_violation", details: { violations: "indisponible" } },
+      ])
+    ).toHaveLength(1);
+    expect(
+      listUnapprovedApprovalRequirements([
+        { key: "rule_violation", details: { violations: [null, "x"] } },
+      ])
+    ).toHaveLength(1);
+  });
+
+  it("still allows forcing past an explicit non-approval rule violation", () => {
+    expect(
+      listUnapprovedApprovalRequirements([
+        {
+          key: "rule_violation",
+          details: { violations: [{ rule_id: "r1", action: "block", rule_type: "min_margin" }] },
+        },
+        { key: "no_pdf_generated" },
+      ])
+    ).toEqual([]);
+    // Un signal max_discount indisponible ne peut pas être levé par une
+    // approbation (rules-engine) : seul un forçage motivé peut le franchir.
+    expect(
+      listUnapprovedApprovalRequirements([
+        {
+          key: "rule_violation",
+          details: {
+            unavailable_signals: [
+              { rule_id: "r2", rule_type: "max_discount", action: "require_approval" },
+            ],
+          },
+        },
+      ])
+    ).toEqual([]);
+  });
+
+  it("refuses forcing past an unavailable approval signal that an approval could clear", () => {
+    // rules-engine lève ce signal dès qu'une approbation fraîche existe :
+    // le circuit d'approbation peut donc l'accorder, le forçage ne doit pas.
+    expect(
+      listUnapprovedApprovalRequirements([
+        {
+          key: "rule_violation",
+          details: {
+            unavailable_signals: [
+              { rule_id: "r3", rule_type: "min_margin", action: "require_approval" },
+              { rule_id: "r4", rule_type: "min_margin", action: "warn" },
+            ],
+          },
+        },
+      ])
+    ).toEqual([
+      expect.objectContaining({ ruleId: "r3" }),
+    ]);
+  });
+
+  it("rejects reasons without enough letters or digits", () => {
+    expect(resolveForceSendReason("..........")).toBeNull();
+    expect(resolveForceSendReason("ㅤ".repeat(12))).toBeNull();
+    expect(resolveForceSendReason("- - - - - - ok")).toBeNull();
+    expect(resolveForceSendReason("Prix fournisseur confirmé")).toBe("Prix fournisseur confirmé");
+  });
+});
diff --git a/src/lib/estimates/force-send-policy.ts b/src/lib/estimates/force-send-policy.ts
new file mode 100644
index 00000000..e612be49
--- /dev/null
+++ b/src/lib/estimates/force-send-policy.ts
@@ -0,0 +1,138 @@
+/**
+ * Règles du forçage d'envoi draft -> sent, partagées par le serveur (seule
+ * autorité) et l'interface (qui n'offre pas un forçage voué au refus).
+ */
+
+export const FORCE_SEND_REASON_MIN_LENGTH = 10;
+export const FORCE_SEND_REASON_MAX_LENGTH = 500;
+/** Un motif doit dire quelque chose : ponctuation et blancs seuls ne suffisent pas. */
+const FORCE_SEND_REASON_MIN_ALPHANUMERIC = 5;
+
+// Caractères de remplissage classés comme lettres mais affichés vides
+// (remplissages hangul, motif braille vide).
+const INVISIBLE_FILLERS = /[ᅟᅠㅤﾠ⠀]/gu;
+
+// Contrôles C0/C1 (Cc) et caractères de format invisibles (Cf : largeur nulle,
+// marques de direction) qui pourraient masquer ou retourner le texte affiché.
+export function normalizeForceSendReason(value: unknown): string {
+  if (typeof value !== "string") return "";
+  return value
+    .replace(/\p{Cc}/gu, " ")
+    .replace(/\p{Cf}/gu, "")
+    .replace(INVISIBLE_FILLERS, "")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** Motif nettoyé, ou null s'il est absent, vide de sens ou hors des bornes autorisées. */
+export function resolveForceSendReason(value: unknown): string | null {
+  const reason = normalizeForceSendReason(value);
+  const alphanumericCount = reason.match(/[\p{L}\p{N}]/gu)?.length ?? 0;
+  return reason.length >= FORCE_SEND_REASON_MIN_LENGTH &&
+    reason.length <= FORCE_SEND_REASON_MAX_LENGTH &&
+    alphanumericCount >= FORCE_SEND_REASON_MIN_ALPHANUMERIC
+    ? reason
+    : null;
+}
+
+type ForceSendGatingFlag = {
+  key: string;
+  details?: Record<string, unknown> | null;
+};
+
+export type ForceSendApprovalRequirement = {
+  ruleId: string | null;
+  approvalStatus: string | null;
+  message: string | null;
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function toText(value: unknown): string | null {
+  return typeof value === "string" && value.length > 0 ? value : null;
+}
+
+/**
+ * Violations bloquantes d'une règle d'approbation dont l'approbation n'est pas
+ * accordée. Le circuit d'approbation est la seule issue : aucun forçage.
+ * Un signal « indisponible » d'une règle require_approval en fait aussi partie :
+ * le moteur de règles le lève dès qu'une approbation fraîche existe, le circuit
+ * peut donc l'accorder. Seul max_discount fait exception : le moteur ne le lève
+ * jamais par approbation, un forçage motivé reste la seule issue.
+ * Échec fermé : une violation de règle dont le détail est illisible est
+ * traitée comme une approbation exigée, pour qu'une dérive de format du
+ * gating ne rouvre jamais le forçage.
+ */
+export function listUnapprovedApprovalRequirements(
+  blockingFlags: readonly ForceSendGatingFlag[]
+): ForceSendApprovalRequirement[] {
+  const requirements: ForceSendApprovalRequirement[] = [];
+  const unreadable: ForceSendApprovalRequirement = {
+    ruleId: null,
+    approvalStatus: null,
+    message: "Détail des règles métier illisible : l'approbation ne peut pas être écartée.",
+  };
+  for (const flag of blockingFlags) {
+    if (flag.key !== "rule_violation") continue;
+    const violations = flag.details?.violations;
+    if (!Array.isArray(violations)) {
+      const signals = flag.details?.unavailable_signals;
+      if (!Array.isArray(signals)) {
+        requirements.push(unreadable);
+        continue;
+      }
+      if (signals.some((signal) => !isRecord(signal))) {
+        requirements.push(unreadable);
+      }
+      for (const signal of signals) {
+        if (!isRecord(signal)) continue;
+        const requiresApproval =
+          signal.action === "require_approval" || signal.rule_type === "require_approval";
+        if (!requiresApproval || signal.rule_type === "max_discount") continue;
+        requirements.push({
+          ruleId: toText(signal.rule_id),
+          approvalStatus: null,
+          message: toText(signal.message),
+        });
+      }
+      continue;
+    }
+    if (violations.some((violation) => !isRecord(violation))) {
+      requirements.push(unreadable);
+    }
+    for (const violation of violations) {
+      if (!isRecord(violation)) continue;
+      const requiresApproval =
+        violation.action === "require_approval" ||
+        violation.rule_type === "require_approval";
+      if (!requiresApproval || violation.approval_status === "approved") continue;
+      requirements.push({
+        ruleId: toText(violation.rule_id),
+        approvalStatus: toText(violation.approval_status),
+        message: toText(violation.message),
+      });
+    }
+  }
+  return requirements;
+}
+
+/** Identifiants des règles métier contournées par un forçage, sans doublon. */
+export function listForcedRuleIds(
+  blockingFlags: readonly ForceSendGatingFlag[]
+): string[] {
+  const ruleIds = new Set<string>();
+  for (const flag of blockingFlags) {
+    if (flag.key !== "rule_violation") continue;
+    for (const field of ["violations", "unavailable_signals"] as const) {
+      const entries = flag.details?.[field];
+      if (!Array.isArray(entries)) continue;
+      for (const entry of entries) {
+        const ruleId = isRecord(entry) ? toText(entry.rule_id) : null;
+        if (ruleId) ruleIds.add(ruleId);
+      }
+    }
+  }
+  return [...ruleIds];
+}
