  "rules": [
    {
      "id": "app-shell",
      "note": "Racine applicative et coquille du tableau de bord : toutes les pages des parcours.",
      "paths": [
        "src/app/providers.tsx",
        "src/app/globals.css",
        "src/app/global-error.tsx",
        "src/app/not-found.tsx",
        "src/styles/**",
        "src/instrumentation.ts",
        "src/app/dashboard/{layout,error,loading,not-found}.tsx",
        "src/app/dashboard/[...unknown]/**"
      ],
      "journeys": ["*"]
    },
    {
      "id": "login-signup",
      "note": "Formulaires publics ; le setup de connexion est toujours sélectionné.",
      "paths": ["src/app/login/**", "src/app/signup/**"],
      "journeys": ["@anonymous"]
    },
    {
      "id": "dashboard-ux-pages",
      "note": "Pages auditées par UX01-UX29.",
      "paths": [
        "src/app/dashboard/page.tsx",
        "src/app/dashboard/takeoff/**",
        "src/app/dashboard/products/**",
        "src/app/dashboard/prices/**",
        "src/app/dashboard/admin/*.tsx",
        "src/app/dashboard/admin/flags/**",
        "src/app/dashboard/admin/anomaly-history/**"
      ],
      "journeys": ["e2e/army/critical/dashboard-ux.e2e.ts"]
    },
    {
      "id": "affaires-list",
      "note": "Les parcours du métré s'y connectent (loginWithUi, e2e/army/takeoff/native-ui.ts).",
      "paths": ["src/app/dashboard/affaires/page.tsx"],
      "journeys": ["@affaires-list", "@takeoff-hub"]
    },
    {
      "id": "affaires-boundaries",
      "note": "error/loading et actions serveur des affaires enveloppent la liste, le hub et ses sous-routes.",
      "paths": [
        "src/app/dashboard/affaires/{error,loading}.tsx",
        "src/app/dashboard/affaires/_actions/**",
        "src/app/dashboard/affaires/new/**"
      ],
      "journeys": ["@affaires-list", "@affaire-hub", "@plans", "@affaire-takeoff", "@takeoff-hub", "@takeoff-wizard"]
    },
    {
      "id": "affaire-hub",
      "note": "Le layout du hub enveloppe plans, métré et prix de l'affaire.",
      "paths": ["src/app/dashboard/affaires/[projectId]/*.tsx"],
      "journeys": ["@affaire-hub", "@plans", "@affaire-takeoff", "@takeoff-hub"]
    },
    {
      "id": "affaire-plans",
      "paths": ["src/app/dashboard/affaires/[projectId]/plans/**"],
      "journeys": ["@plans"]
    },
    {
      "id": "affaire-takeoff",
      "paths": ["src/app/dashboard/affaires/[projectId]/takeoff/**"],
      "journeys": ["@affaire-takeoff", "@takeoff-affaire-takeoff"]
    },
    {
      "id": "affaire-prices",
      "note": "Import CSV fournisseur de la page prix de l'affaire : US-4.1, US-4.1b et US-4.1c.",
      "paths": ["src/app/dashboard/affaires/[projectId]/prices/**"],
      "journeys": ["e2e/army/takeoff/team-b-user-stories.e2e.ts"]
    },
    {
      "id": "estimate-wizard",
      "note": "createEstimateViaWizard (e2e/army/critical/fixtures.ts) ouvre l'assistant puis l'éditeur, aussi pour les parcours du métré.",
      "paths": ["src/app/dashboard/estimates/new/**"],
      "journeys": ["@wizard", "@takeoff-wizard"]
    },
    {
      "id": "estimate-editor",
      "paths": ["src/app/dashboard/estimates/[versionId]/edit/**"],
      "journeys": ["@editor", "@takeoff-wizard"]
    },
    {
      "id": "estimate-takeoff",
      "note": "Revue d'un job de métré depuis la version (TKF, contracts.e2e.ts).",
      "paths": ["src/app/dashboard/estimates/[versionId]/takeoff/**"],
      "journeys": ["e2e/army/takeoff/contracts.e2e.ts"]
    },
    {
      "id": "estimate-print",
      "paths": ["src/app/dashboard/estimates/[versionId]/print/**"],
      "journeys": ["@print"]
    },
    {
      "id": "estimate-detail",
      "note": "Fiche de version : seuls les parcours du moteur 3 l’ouvrent (bandeau de lecture de 2.1, brouillon v3 de 2.6).",
      "paths": ["src/app/dashboard/estimates/[versionId]/page.tsx"],
      "journeys": ["e2e/army/local/engine-v3-editor-actions.e2e.ts", "e2e/army/local/engine-v3-editor.e2e.ts", "e2e/army/local/engine-v3-fail-closed.e2e.ts"]
    },
    {
      "id": "estimates-boundaries",
      "note": "error/loading des devis enveloppent assistant, éditeur et impression.",
      "paths": ["src/app/dashboard/estimates/{error,loading}.tsx"],
      "journeys": ["@editor", "e2e/army/critical/deslop-components.e2e.ts", "@takeoff-wizard"]
    },
    {
      "id": "estimate-list",
      "note": "Monté par la fixture deslop-client-list.",
      "paths": ["src/app/dashboard/estimates/page.tsx"],
      "journeys": ["e2e/army/critical/deslop-components.e2e.ts"]
    },
    {
      "id": "approvals-queue",
      "note": "File d'approbation : V3P01 y lit la carte de l'affaire (HT et marge nette v3).",
      "paths": ["src/app/dashboard/approvals/**"],
      "journeys": ["e2e/army/local/engine-v3-persistence.e2e.ts"]
    },
    {
      "id": "dpgf-pages",
      "note": "DPGF03 traverse historique d'import, mapping et catalogue ; US-2.1 et US-2.2 importent puis mappent.",
      "paths": [
        "src/app/dashboard/imports/**",
        "src/app/dashboard/mappings/**",
        "src/app/dashboard/catalogue/**"
      ],
      "journeys": ["e2e/army/critical/dpgf-import.e2e.ts", "e2e/army/takeoff/team-b-user-stories.e2e.ts"]
    },
    {
      "id": "purchase-orders",
      "note": "US-4.4 rouvre le brouillon de bon de commande créé depuis l'affaire.",
      "paths": ["src/app/dashboard/orders/**"],
      "journeys": ["e2e/army/takeoff/team-b-user-stories.e2e.ts"]
    },
    {
      "id": "unexercised-routes",
      "note": "Routes connues qu'aucun parcours critical ou du métré n'ouvre ; leurs modules partagés restent suivis par le graphe d'imports.",
      "paths": [
        "src/app/page.tsx",
        "src/app/favicon.ico",
        "src/app/portal/**",
        "src/app/dashboard/_actions/**",
        "src/app/dashboard/estimates/[versionId]/{diff,plans,source-review}/**",
        "src/app/dashboard/estimates/{assemblies,dashboard,templates}/**",
        "src/app/dashboard/admin/{currencies,procurement-reset,rules,suggestion-learning,takeoff}/**",
        "src/app/dashboard/{analytics,direction,indices,memberships,profile,referentiel,sites,suppliers,tarifs,tenants}/**"
      ],
      "journeys": []
    },
    {
      "id": "openapi",
      "note": "Génération OpenAPI : validée par Quality Gate et par l'étape OpenAPI du build Army ; aucun parcours ne lit /api/docs.",
      "paths": ["src/lib/openapi/**"],
      "journeys": []
    },
    {
      "id": "api-without-ui-caller",
      "note": "Routes API qu'aucun code de l'application ni parcours ne nomme (documentation, santé, tâches internes et planifiées). Les autres routes sélectionnent, par le graphe, les parcours qui les appellent ; une nouvelle route sans appelant reste non cartographiée, donc suite complète.",
      "paths": [
        "src/app/api/docs/route.ts",
        "src/app/api/docs/swagger-ui/[asset]/route.ts",
        "src/app/api/health/route.ts",
        "src/app/api/imports/tabular-pdf/review/route.ts",
        "src/app/api/internal/takeoff/process-job/route.ts",
        "src/app/api/internal/workflows/recover/route.ts"
      ],
      "journeys": []
    },
    {
      "id": "runtime-unused-modules",
      "note": "Modules importés seulement par des tests, ou par aucun fichier : aucune page ne les charge. Dès qu'un fichier de l'application les importe, le graphe suit cet importeur.",
      "paths": [
        "src/components/affaires/OnboardingIntakeDropzone.tsx",
        "src/components/affaires/QuickCreateAffaireDialog.tsx",
        "src/components/catalogue/prices-manager/SupplierCatalogItemModal.tsx",
        "src/components/takeoff/ProjectTakeoffJobList.tsx",
        "src/components/takeoff/evidence-source-context.ts",
        "src/components/ui/{checkbox,empty,select,switch,table}.tsx",
        "src/hooks/useEstimateLineTruthVisibility.ts",
        "src/lib/affaires/route-segments.ts",
